PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/socioverse
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5000
NODE_ENV=development
# Local demo only: exposes reset email previews. Never enable on a public server.
DEV_EMAIL_PREVIEW=false
# Configure SMTP for real password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SocioVerse <no-reply@example.com>"
